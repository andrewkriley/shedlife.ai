# Dev-mode secrets, read directly as env vars by EnvVarSecretsClient.
# In a real deployment these are Infisical references (infisical://the-shed/...);
# this file documents the dev-mode env var name each one maps to.
# See backend/src/theshed/secrets/client.py and docs/spec/secrets-management.md.

DATABASE_URL=postgresql+asyncpg://theshed:theshed@localhost:5432/theshed
REDIS_URL=redis://localhost:6379/0

# infisical://the-shed/providers/anthropic/api_key
ANTHROPIC_API_KEY=

# infisical://the-shed/providers/openai/api_key
# Optional — only the settings surface's live models-list calls this; a
# sub-agent using OpenAI isn't wired up yet.
OPENAI_API_KEY=

# infisical://the-shed/observability/galileo_api_key
GALILEO_API_KEY=
# infisical://the-shed/observability/galileo_console_url
# Required for any non-default (e.g. self-hosted, or a dedicated multitenant
# instance) Galileo deployment — without it the SDK silently defaults to the
# public app.galileo.ai, and a key valid only on another instance 401s there
# with no indication that the console URL was the actual problem.
GALILEO_URL=
GALILEO_PROJECT_NAME=the-shed
GALILEO_LOG_STREAM=default

# Session signing / CSRF (dev only — a real deployment generates and stores this
# via the secrets backend, not a checked-in default).
SESSION_SECRET=dev-only-change-me
