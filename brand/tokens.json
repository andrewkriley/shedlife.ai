{
  "$description": "Vendored copy of therileys-team (andrewkriley/design-system). Dark-only, self-contained — do not merge with shared.json. See docs/stack.md.",
  "meta": {
    "mode": "Dark",
    "source": "design-system/tokens/therileys-team.json",
    "pattern": "therileys-team"
  },
  "color": {
    "bg": { "canvas": "#0e1116", "panel": "#161b22" },
    "text": { "primary": "#e6edf3", "muted": "#8b949e" },
    "border": { "default": "#30363d" },
    "accent": {
      "default": "#58a6ff",
      "success": "#3fb950",
      "warning": "#d29922",
      "danger": "#f85149",
      "violet": "#a371f7",
      "cyan": "#39d0d8"
    }
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 32 },
  "radius": { "sm": 8, "md": 12, "full": 999 },
  "type": {
    "display": { "size": 28, "weight": 700, "lineHeight": 36 },
    "title": { "size": 16, "weight": 500, "lineHeight": 24 },
    "body": { "size": 14, "weight": 400, "lineHeight": 20 },
    "caption": { "size": 12, "weight": 400, "lineHeight": 16 },
    "label": { "size": 11, "weight": 500, "lineHeight": 16 }
  }
}
